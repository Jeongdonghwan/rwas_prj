# 복사해서 .env 로 저장 후 값 채우기
SECRET_KEY=change-me
# 로컬 개발: 비워두면 SQLite(instance/dev.db) 사용
# 운영(Cafe24 MariaDB): mysql+pymysql://user:pass@localhost/dbname?charset=utf8mb4
DATABASE_URL=

# 배포 도메인 (canonical·og·sitemap·RSS 절대주소). 기본값 https://suwonlei.com
SITE_URL=https://suwonlei.com
# 네이버 서치어드바이저 / 구글 서치콘솔 소유확인 메타값
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# 어드민 로그인
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
