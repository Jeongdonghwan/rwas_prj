# 복사해서 .env 로 저장 후 값 채우기
SECRET_KEY=change-me
# 로컬 개발: 비워두면 SQLite(instance/dev.db) 사용
# 운영(Cafe24 MariaDB): mysql+pymysql://user:pass@localhost/dbname?charset=utf8mb4
DATABASE_URL=

# 배포 도메인 (canonical·og·sitemap·RSS 절대주소). 기본값 https://suwonlei.com
SITE_URL=https://suwonlei.com
# 네이버 서치어드바이저 / 구글 서치콘솔 소유확인 메타값
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# 어드민 주소 (기본 leilaw → https://도메인/leilaw/). /admin은 봇이 늘 두드린다.
ADMIN_PATH=leilaw
# 어드민 로그인 — 계정이 하나도 없을 때만 이 값으로 최초 계정을 만든다.
# 그 뒤 아이디·비밀번호는 /admin/account 화면에서 관리한다(여기 값은 무시됨).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# https로 서비스할 때 1로 — 세션 쿠키를 https 전용으로 만든다
SESSION_COOKIE_SECURE=1

# ── 문자 발송 (알리고 https://smartsms.aligo.in) ──────────────────
# 발신번호는 알리고에 사전 등록된 번호여야 하고,
# **발신 서버 IP도 알리고에 등록해야 실제 발송이 된다.**
ALIGO_USER_ID=
ALIGO_API_KEY=
# 발신번호 — 알리고에 사전등록·승인된 번호. 사이트 상담번호(1644-6755)와 다르다.
ALIGO_SENDER=01096316616
# Y로 두면 실제 발송 없이 응답만 받는다(과금 없음). 운영에서는 비워둘 것
ALIGO_TEST_MODE=Y
# 설정하면 새 접수 때 사무소에도 알림 문자를 보낸다
ALIGO_ADMIN_PHONE=
